# Local-only credentials. Replace every value before shared or production-like use.
APP_ENV=development
CONTROL_PLANE_ADMIN_TOKEN=replace-with-local-admin-token
GATEWAY_SHARED_TOKEN=replace-with-local-gateway-token
TOKEN_PEPPER=replace-with-random-token-pepper

STORE_BACKEND=redis
REDIS_ADDR=localhost:6379
CONTROL_PLANE_HOST=localhost
CONTROL_PLANE_PORT=8080
CONTROL_PLANE_TIMEOUT_MS=1000
GATEWAY_PORT=9000

WORKER_COUNT=0
AUTH_WORKER_COUNT=2
REQUEST_QUEUE_CAPACITY=4096
AUTH_QUEUE_CAPACITY=32
RESPONSE_QUEUE_CAPACITY=4096
SHUTDOWN_TIMEOUT_MS=5000

AUTH_FAILURE_LIMIT=5
AUTH_FAILURE_WINDOW_SECONDS=60
